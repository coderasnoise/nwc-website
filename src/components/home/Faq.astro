---
import { getEntry } from 'astro:content';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('faq', lang);
---
<section class="section bg-paper">
  <div class="wrap grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4"><p class="eyebrow">{pick(lang, 'Questions', 'Sorular')}</p><h2 class="mt-5">{pick(lang, 'Before you write to us', 'Yazmadan önce')}</h2></div>
    <div class="md:col-span-7 md:col-start-6 border-t border-line">
      {entry!.data.items.map((i) => <details class="border-b border-line py-5"><summary class="cursor-pointer font-display text-xl">{i.q}</summary><p class="mt-3 max-w-xl text-muted">{i.a}</p></details>)}
    </div>
  </div>
</section>
