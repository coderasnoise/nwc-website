---
import { getEntry } from 'astro:content';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('faq', lang);
---
<section class="section border-t border-line">
  <div class="wrap grid gap-10 md:grid-cols-12">
    <div data-reveal class="md:col-span-4"><p class="eyebrow">{pick(lang, 'Questions', 'Sorular')}</p><h2 class="mt-5">{pick(lang, 'Before you write to us', 'Yazmadan önce')}</h2></div>
    <div data-reveal style="--d:100ms" class="border-t border-line md:col-span-7 md:col-start-6">
      {entry!.data.items.map((i) => <details class="faq border-b border-line py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl"><span>{i.q}</span><span aria-hidden="true" class="plus relative block h-3 w-3 shrink-0"><i class="absolute left-0 top-1/2 block h-px w-3 bg-clay"></i><i class="v absolute left-1/2 top-0 block h-3 w-px bg-clay"></i></span></summary><p class="mt-3 max-w-xl text-muted">{i.a}</p></details>)}
    </div>
  </div>
</section>
<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq .v { transition: transform 400ms var(--ease); }
  .faq[open] .v { transform: scaleY(0); }
</style>
