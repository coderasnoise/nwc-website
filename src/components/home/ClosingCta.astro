---
import { pick, type Lang } from '../../i18n';
import WhatsAppButton from '../WhatsAppButton.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <h2 class="max-w-3xl text-4xl md:text-6xl">{pick(lang, 'Tell us what you have in mind.', 'Aklınızdakini bize yazın.')}</h2>
    <p class="mt-6 max-w-md text-muted">{pick(lang, 'You will get a personal plan and a quote on WhatsApp, with no obligation.', 'Kişisel planı ve teklifi WhatsApp’tan alırsınız, bir yükümlülük yok.')}</p>
    <div class="mt-10"><WhatsAppButton lang={lang} /></div>
  </div>
</section>
