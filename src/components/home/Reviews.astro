---
import { site } from '../../config/site';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="rule">
  <div class="wrap grid items-center gap-8 py-16 md:grid-cols-12">
    <h2 class="md:col-span-6">{pick(lang, 'Patients write about their experience in their own words.', 'Hastalarımız deneyimlerini kendi sözleriyle yazıyor.')}</h2>
    <div class="flex flex-wrap gap-x-8 gap-y-3 md:col-span-5 md:col-start-8 md:justify-end">
      <a href={site.reviewLinks.trustpilot} rel="noopener" target="_blank" class="border-b border-ink pb-1">{pick(lang, 'Read on Trustpilot', 'Trustpilot’ta oku')}</a>
      <a href={site.reviewLinks.google} rel="noopener" target="_blank" class="border-b border-ink pb-1">{pick(lang, 'Read on Google', 'Google’da oku')}</a>
    </div>
  </div>
</section>
