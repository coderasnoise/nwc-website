---
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = [
  [pick(lang, 'A message', 'Bir mesaj'), pick(lang, 'Write to us on WhatsApp. The first consultation is free and online.', 'WhatsApp’tan yazın. İlk konsültasyon ücretsiz ve online.')],
  [pick(lang, 'Your plan', 'Planınız'), pick(lang, 'Dr. Aksan looks at your photos and prepares a surgery plan for you personally.', 'Dr. Aksan fotoğraflarınıza bakar ve size özel bir ameliyat planı hazırlar.')],
  [pick(lang, 'Istanbul', 'İstanbul'), pick(lang, 'You travel only once you have decided to go ahead.', 'Yalnızca karar verdikten sonra yola çıkarsınız.')],
  [pick(lang, 'Afterwards', 'Sonrası'), pick(lang, 'Aftercare and check-ups are agreed with you before you leave.', 'Bakım ve kontroller, ayrılmadan önce sizinle konuşulur.')],
];
---
<section class="section bg-ink text-white">
  <div class="wrap">
    <div data-reveal class="grid gap-6 md:grid-cols-12">
      <p class="eyebrow !text-white/70 md:col-span-3">{pick(lang, 'How it works', 'Süreç')}</p>
      <h2 class="!text-white md:col-span-8">{pick(lang, 'From first message to recovery', 'İlk mesajdan iyileşmeye')}</h2>
    </div>
    <ol class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-4">
      {steps.map(([a, b], i) => <li data-reveal style={`--d:${i * 80}ms`} class="border-t border-white/25 pt-6"><span class="font-display text-5xl text-white/60">{String(i + 1).padStart(2, '0')}</span><h3 class="mt-6 text-2xl !text-white">{a}</h3><p class="mt-3 text-sm text-white/75">{b}</p></li>)}
    </ol>
  </div>
</section>
