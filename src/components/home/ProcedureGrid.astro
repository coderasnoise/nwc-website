---
import { getProcedures, procedurePath, proceduresIndexPath } from '../../lib/procedures';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = await getProcedures(lang);
const groups = [['face', pick(lang, 'Face', 'Yüz')], ['body', pick(lang, 'Body', 'Vücut')]] as const;
---
<section class="bg-sand">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-navy/70">{pick(lang, 'Procedures', 'İşlemler')}</p>
    <h2 class="mt-2 text-3xl font-bold">{pick(lang, 'What Dr. Aksan does', 'Dr. Aksan’ın yaptığı işlemler')}</h2>
    {groups.map(([g, label]) => (
      <div class="mt-8">
        <h3 class="text-lg font-semibold">{label}</h3>
        <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {all.filter((p) => p.group === g).map((p) => (
            <li><a href={procedurePath(lang, p.slug)} class="block h-full rounded-xl bg-white p-5 shadow-sm transition hover:shadow-md">
              <span class="font-display text-lg font-bold text-navy">{p.title}</span>
              <span class="mt-2 block text-sm text-slate-600">{p.summary}</span>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
    <a href={proceduresIndexPath(lang)} class="mt-8 inline-block font-semibold text-navy underline">{pick(lang, 'All procedures', 'Tüm işlemler')}</a>
  </div>
</section>
