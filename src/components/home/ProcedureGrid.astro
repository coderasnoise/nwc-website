---
import { getProcedures, procedurePath, proceduresIndexPath } from '../../lib/procedures';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = await getProcedures(lang);
const groups = [['face', pick(lang, 'Face', 'Yüz')], ['body', pick(lang, 'Body', 'Vücut')]] as const;
let n = 0;
---
<section class="section bg-paper">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-12">
      <p class="eyebrow md:col-span-3">{pick(lang, 'Procedures', 'İşlemler')}</p>
      <h2 class="md:col-span-8">{pick(lang, 'What Dr. Aksan operates on', 'Dr. Aksan’ın ameliyat ettiği bölgeler')}</h2>
    </div>
    {groups.map(([g, label]) => (
      <div class="mt-14 grid gap-4 md:grid-cols-12">
        <h3 class="text-xl text-clay md:col-span-3">{label}</h3>
        <ul class="md:col-span-9 border-t border-line">
          {all.filter((p) => p.group === g).map((p) => (
            <li class="border-b border-line"><a href={procedurePath(lang, p.slug)} class="group grid gap-1 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-baseline sm:gap-6">
              <span class="hidden text-sm text-clay sm:block">{String(++n).padStart(2, '0')}</span>
              <span>
                <span class="font-display text-2xl transition-colors group-hover:text-clay">{p.title}</span>
                <span class="mt-1 block max-w-xl text-[0.95rem] text-muted">{p.summary}</span>
              </span>
              <span aria-hidden="true" class="hidden text-xl text-clay transition-transform group-hover:translate-x-1 sm:block">→</span>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
    <p class="mt-10 md:pl-[25%]"><a href={proceduresIndexPath(lang)} class="border-b border-ink pb-1">{pick(lang, 'All procedures', 'Tüm işlemler')}</a></p>
  </div>
</section>
