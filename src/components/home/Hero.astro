---
import { site } from '../../config/site';
import { pick, type Lang } from '../../i18n';
import WhatsAppButton from '../WhatsAppButton.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section>
  <div class="wrap grid items-end gap-12 pb-16 pt-12 md:grid-cols-12 md:gap-8 md:pb-24 md:pt-20">
    <div class="md:col-span-7 md:pb-6">
      <p class="eyebrow">{pick(lang, 'Istanbul · Plastic surgery', 'İstanbul · Plastik cerrahi')}</p>
      <h1 class="mt-6">{site.doctor.name}</h1>
      <p class="mt-8 max-w-md text-xl leading-relaxed text-muted">{pick(lang,
        'Face and body surgery, planned one patient at a time. Turkish board-certified.',
        'Yüz ve vücut ameliyatları, her hasta için ayrı planlanır. Türk board sertifikalı.')}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <WhatsAppButton lang={lang} />
      </div>
      <p class="mt-8 text-sm text-muted">
        {pick(lang, 'Read what patients say on', 'Hasta yorumları:')}
        <a href={site.reviewLinks.trustpilot} rel="noopener" target="_blank" class="text-ink underline">Trustpilot</a>
        {pick(lang, 'and', 've')}
        <a href={site.reviewLinks.google} rel="noopener" target="_blank" class="text-ink underline">Google</a>.
      </p>
    </div>
    <div class="md:col-span-5">
      <img src="/placeholders/doctor-portrait.svg" alt={pick(lang, 'Dr. Tolga Aksan (portrait to come)', 'Dr. Tolga Aksan (portre eklenecek)')} width="600" height="750" class="aspect-[4/5] w-full object-cover" fetchpriority="high" />
    </div>
  </div>
</section>
