---
import { site } from '../../config/site';
import { pick, type Lang } from '../../i18n';
import WhatsAppButton from '../WhatsAppButton.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="bg-sand">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-12 md:grid-cols-2 md:py-20">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-navy/70">{pick(lang, 'Plastic surgeon · Istanbul', 'Plastik cerrah · İstanbul')}</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight md:text-5xl">{site.doctor.name}</h1>
      <p class="mt-4 max-w-md text-lg text-slate-700">{pick(lang,
        'Turkish board-certified plastic surgeon. Facial rejuvenation and body contouring, planned personally for you.',
        'Türk board sertifikalı plastik cerrah. Yüz gençleştirme ve vücut şekillendirme, size özel planlanır.')}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <WhatsAppButton lang={lang} />
        <a href={site.reviewLinks.trustpilot} rel="noopener" target="_blank" class="rounded-full border border-navy/30 px-4 py-2 text-xs font-semibold text-navy">Trustpilot</a>
        <a href={site.reviewLinks.google} rel="noopener" target="_blank" class="rounded-full border border-navy/30 px-4 py-2 text-xs font-semibold text-navy">Google</a>
      </div>
    </div>
    <img src="/placeholders/doctor-portrait.svg" alt={pick(lang, 'Dr. Tolga Aksan (placeholder portrait)', 'Dr. Tolga Aksan (yer tutucu portre)')} width="600" height="750" class="mx-auto w-full max-w-md rounded-2xl object-cover" fetchpriority="high" />
  </div>
</section>
