---
import { site } from '../../config/site';
import { pick, type Lang } from '../../i18n';
import WhatsAppButton from '../WhatsAppButton.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section>
  <div class="wrap grid items-end gap-14 pb-20 pt-10 md:grid-cols-12 md:gap-8 md:pb-28 md:pt-20">
    <div class="md:col-span-7 md:pb-4">
      <p class="eyebrow hero-in">{pick(lang, 'Plastic surgery · Istanbul', 'Plastik cerrahi · İstanbul')}</p>
      <h1 class="hero-in mt-6" style="--d:80ms">{site.doctor.name}</h1>
      <p class="hero-in mt-8 max-w-[34ch] text-xl text-muted" style="--d:200ms">{pick(lang,
        'Face and body surgery, planned for one person at a time. Turkish board certified.',
        'Yüz ve vücut ameliyatları, her kişi için ayrı planlanır. Türk board sertifikalı.')}</p>
      <div class="hero-in mt-10 flex flex-wrap items-center gap-x-6 gap-y-3" style="--d:300ms">
        <WhatsAppButton lang={lang} />
        <span class="text-sm text-muted">{pick(lang, 'Free, online, no obligation', 'Ücretsiz, online, taahhütsüz')}</span>
      </div>
      <p class="hero-in mt-10 text-sm text-muted" style="--d:380ms">
        {pick(lang, 'Patients write about their experience on', 'Hastaların deneyimleri:')}
        <a href={site.reviewLinks.trustpilot} rel="noopener" target="_blank" class="text-ink underline">Trustpilot</a>
        {pick(lang, 'and', 've')}
        <a href={site.reviewLinks.google} rel="noopener" target="_blank" class="text-ink underline">Google</a>.
      </p>
    </div>
    <figure class="hero-in md:col-span-5" style="--d:150ms">
      <div class="overflow-hidden rounded-t-full border border-line bg-paper p-2">
        <img src="/placeholders/doctor-portrait.svg" alt={pick(lang, 'Dr. Tolga Aksan (portrait to come)', 'Dr. Tolga Aksan (portre eklenecek)')} width="600" height="750" class="aspect-[4/5] w-full rounded-t-full object-cover" fetchpriority="high" />
      </div>
      <figcaption class="mt-4 flex justify-between text-xs uppercase tracking-[0.18em] text-muted"><span>{pick(lang, 'Co-founder', 'Kurucu ortak')}</span><span>North Western Clinic</span></figcaption>
    </figure>
  </div>
</section>
