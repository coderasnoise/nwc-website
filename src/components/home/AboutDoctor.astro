---
import { getEntry, render } from 'astro:content';
import { pick, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = await getEntry('doctor', lang);
const { Content } = await render(entry!);
const href = pick(lang, '/doctor/', '/tr/doktor/');
---
<section class="section">
  <div class="wrap grid items-center gap-14 md:grid-cols-12">
    <img src="/placeholders/doctor-casual.svg" alt={pick(lang, 'Dr. Aksan (photo to come)', 'Dr. Aksan (fotoğraf eklenecek)')} width="600" height="750" loading="lazy" class="aspect-[4/5] w-full object-cover md:col-span-5" />
    <div class="md:col-span-6 md:col-start-7">
      <p class="eyebrow">{pick(lang, 'The surgeon', 'Cerrah')}</p>
      <h2 class="mt-5">{entry!.data.name}</h2>
      <div class="mt-8 space-y-4 text-muted"><Content /></div>
      <a href={href} class="mt-8 inline-block border-b border-ink pb-1 text-ink">{pick(lang, 'More about Dr. Aksan', 'Dr. Aksan hakkında daha fazlası')}</a>
    </div>
  </div>
</section>
