---
import { site, REVIEW_NOTICE, REVIEW_NOTICE_TR } from '../config/site';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (en: string, tr: string) => (lang === 'en' ? en : tr);
---
<footer class="mt-20 bg-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold">North Western Clinic</p>
      <p class="mt-2 text-sm text-white/70">{p('Plastic surgery in Istanbul, led by Dr. Tolga Aksan.', 'İstanbul’da Dr. Tolga Aksan öncülüğünde plastik cerrahi.')}</p>
    </div>
    <div class="text-sm text-white/80">
      <p class="font-semibold text-white">{t(lang, 'footer.clinic')}</p>
      <p class="mt-2"><a href={site.mapUrl} rel="noopener" target="_blank">{site.address}</a></p>
      <p class="mt-2"><a href={`tel:${site.phoneDisplay.replaceAll(' ', '')}`}>{site.phoneDisplay}</a></p>
    </div>
    <div class="text-sm text-white/80">
      <p class="font-semibold text-white">{t(lang, 'footer.legal')}</p>
      <ul class="mt-2 space-y-1">
        <li><a href={lang === 'en' ? '/team/' : '/tr/ekip/'}>{t(lang, 'footer.team')}</a></li>
        <li><a href={lang === 'en' ? '/reviews/' : '/tr/yorumlar/'}>{t(lang, 'footer.reviews')}</a></li>
        <li><a href={lang === 'en' ? '/clinic/' : '/tr/klinik/'}>{t(lang, 'footer.clinic')}</a></li>
        <li><a href={lang === 'en' ? '/privacy/' : '/tr/gizlilik/'}>{t(lang, 'footer.privacy')}</a></li>
        <li><a href={lang === 'en' ? '/terms/' : '/tr/kosullar/'}>{t(lang, 'footer.terms')}</a></li>
      </ul>
    </div>
  </div>
  {site.draftMode && <p class="bg-amber-100 px-5 py-2 text-center text-xs text-amber-900">{p(REVIEW_NOTICE, REVIEW_NOTICE_TR)}</p>}
  <p class="border-t border-white/10 px-5 py-4 text-center text-xs text-white/60">© {new Date().getFullYear()} North Western Clinic</p>
</footer>
