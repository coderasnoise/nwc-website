---
import { buildWhatsAppUrl } from '../lib/whatsapp';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; procedure?: string; variant?: 'solid' | 'outline' | 'light'; label?: string }
const { lang, procedure, variant = 'solid', label } = Astro.props;
const msg = procedure ? t(lang, 'wa.procedure', { procedure }) : t(lang, 'wa.default');
const styles = {
  solid: 'bg-wa text-white hover:bg-[#17553a]',
  outline: 'border border-ink text-ink hover:bg-ink hover:text-white',
  light: 'bg-white text-ink hover:bg-paper',
}[variant];
---
<a href={buildWhatsAppUrl(msg)} rel="noopener" target="_blank" class={`inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-3.5 text-[0.95rem] font-medium transition-colors ${styles}`}>
  <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.8-.1 1.5Z"/></svg>
  {label ?? t(lang, 'cta.consult')}
</a>
