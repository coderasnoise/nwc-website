---
import { t, localePath, type Lang } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const nav = [
  ['nav.doctor', lang === 'en' ? '/doctor/' : '/tr/doktor/'],
  ['nav.procedures', lang === 'en' ? '/procedures/' : '/tr/islemler/'],
  ['nav.results', lang === 'en' ? '/results/' : '/tr/sonuclar/'],
  ['nav.journey', lang === 'en' ? '/journey/' : '/tr/yolculuk/'],
  ['nav.blog', lang === 'en' ? '/blog/' : '/tr/blog/'],
];
const current = Astro.url.pathname;
const isCur = (href: string) => current === href || current.startsWith(href);
---
<header class="sticky top-0 z-40 px-3 pt-3 sm:px-6" style="padding-top: max(0.75rem, env(safe-area-inset-top, 0px))">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-line bg-ivory/80 py-2 pl-5 pr-2 backdrop-blur-md">
    <a href={localePath(lang, '/')} class="flex items-center gap-3">
      <img src="/placeholders/logo.svg" alt="" width="28" height="28" />
      <span class="font-display text-base tracking-tight text-ink sm:text-lg">North Western <span class="text-clay">Clinic</span></span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-8 text-sm md:flex">
      {nav.map(([k, href]) => <a href={href} aria-current={isCur(href) ? 'page' : undefined} class:list={['transition-colors duration-300 ease-out hover:text-ink', isCur(href) ? 'text-ink' : 'text-muted']}>{t(lang, k)}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <LangSwitch lang={lang} href={altHref} />
      <div class="hidden sm:block"><WhatsAppButton lang={lang} label={t(lang, 'nav.cta')} size="sm" /></div>
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label={lang === 'en' ? 'Menu' : 'Menü'} class="menu-btn flex h-10 w-10 items-center justify-center rounded-full border border-line md:hidden">
        <span class="relative block h-3 w-5"><i class="bar absolute left-0 top-0 block h-px w-5 bg-ink"></i><i class="bar absolute bottom-0 left-0 block h-px w-5 bg-ink"></i></span>
      </button>
    </div>
  </div>
</header>
<div id="menu-panel" data-open="false" class="menu-panel fixed inset-0 z-30 flex flex-col justify-between bg-ivory/95 px-6 pb-10 pt-28 backdrop-blur-xl md:hidden" style="height: 100dvh">
  <nav aria-label="Main mobile" class="flex flex-col">
    {nav.map(([k, href], i) => <a href={href} style={`--i:${i}`} class="menu-link border-b border-line py-4 font-display text-4xl text-ink">{t(lang, k)}</a>)}
  </nav>
  <div class="menu-link" style="--i:5"><WhatsAppButton lang={lang} /></div>
</div>
<style>
  .bar { transition: transform 500ms var(--ease); }
  .menu-btn[aria-expanded='true'] .bar:first-child { transform: translateY(5.5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .bar:last-child { transform: translateY(-5.5px) rotate(-45deg); }
  .menu-panel { opacity: 0; visibility: hidden; transition: opacity 400ms var(--ease), visibility 0s linear 400ms; }
  .menu-panel[data-open='true'] { opacity: 1; visibility: visible; transition: opacity 400ms var(--ease), visibility 0s; }
  .menu-link { opacity: 0; transform: translateY(24px); transition: opacity 300ms var(--ease), transform 300ms var(--ease); }
  .menu-panel[data-open='true'] .menu-link { opacity: 1; transform: none; transition: opacity 500ms var(--ease) calc(var(--i) * 60ms + 80ms), transform 500ms var(--ease) calc(var(--i) * 60ms + 80ms); }
  @media (prefers-reduced-motion: reduce) { .bar, .menu-link { transform: none !important; } .menu-btn[aria-expanded='true'] .bar:first-child { transform: translateY(5.5px) rotate(45deg) !important; } .menu-btn[aria-expanded='true'] .bar:last-child { transform: translateY(-5.5px) rotate(-45deg) !important; } }
</style>
