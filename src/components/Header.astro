---
import { t, localePath, type Lang } from '../i18n';
import { procedurePath } from '../lib/procedures';
import LangSwitch from './LangSwitch.astro';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const nav = [
  ['nav.doctor', lang === 'en' ? '/doctor/' : '/tr/doktor/'],
  ['nav.procedures', lang === 'en' ? '/procedures/' : '/tr/islemler/'],
  ['nav.results', lang === 'en' ? '/results/' : '/tr/sonuclar/'],
  ['nav.journey', lang === 'en' ? '/journey/' : '/tr/yolculuk/'],
  ['nav.blog', lang === 'en' ? '/blog/' : '/tr/blog/'],
];
---
<header class="sticky top-0 z-30 border-b border-navy/10 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href={localePath(lang, '/')} class="flex items-center gap-2 font-display text-lg font-bold text-navy">
      <img src="/placeholders/logo.svg" alt="" width="32" height="32" />
      North Western Clinic
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm text-navy md:flex">
      {nav.map(([k, href]) => <a href={href} class="hover:underline">{t(lang, k)}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <LangSwitch lang={lang} href={altHref} />
      <div class="hidden sm:block"><WhatsAppButton lang={lang} label={t(lang, 'nav.cta')} /></div>
    </div>
  </div>
  <nav aria-label="Main mobile" class="flex gap-4 overflow-x-auto border-t border-navy/10 px-5 py-2 text-sm text-navy md:hidden">
    {nav.map(([k, href]) => <a href={href} class="whitespace-nowrap">{t(lang, k)}</a>)}
  </nav>
</header>
